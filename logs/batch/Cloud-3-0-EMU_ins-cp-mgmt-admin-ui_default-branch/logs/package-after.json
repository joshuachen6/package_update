{
  "name": "ins-cp-mgmt-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app_port": "SET PORT=9090",
    "next_env": "SET VAULT_INJECTON_ENABLED=true&SET NEXTAUTH_URL=https://localhost:3000/api/auth&SET API_URL=https://dev-eastus2-consentandpreferenceplatform.humana.com",
    "start:k8s": "./node_modules/next/dist/bin/next start",
    "dev": "SET VAULT_INJECTON_ENABLED=true&SET NEXTAUTH_URL=https://localhost:3000/api/auth&SET API_URL=https://dev-eastus2-consentandpreferenceplatform.humana.com&next dev --turbo --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "coverage": "jest --collect-coverage",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "pretty-quick --staged",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "fix-lint": "eslint . --fix",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run build",
    "copy-static-files": "xcopy .next\\static .next\\standalone\\.next /s /r /Y",
    "copy-icons": "xcopy \\public .next\\standalone\\public /s /r /D /Y",
    "serve": "npm run copy-static-files && npm run copy-icons && node .next/standalone/server.js"
  },
