      "build_text": "buildscript {\n    repositories {\n        maven {\n            url 'https://humana.jfrog.io/artifactory/eai-gradle-virtual'\n            credentials {\n                username System.getenv('ARTIFACTORY_USERNAME')\n                password System.getenv('ARTIFACTORY_PASSWORD')\n            }\n        }\n\n    }\n    dependencies {\n        //Check for the latest version here: http://plugins.gradle.org/plugin/com.jfrog.artifactory\n        classpath \"org.jfrog.buildinfo:build-info-extractor-gradle:4+\"\n    }\n}\n\nplugins {\n    id 'org.springframework.boot' version '3.5.14'\n    id 'io.spring.dependency-management' version '1.1.7'\n    id 'application'\n    id 'java'\n    id 'jacoco'\n    id \"org.sonarqube\" version \"6.3.1.5724\"\n\n}\n\ngroup = 'com.humana.domain'\nversion = '2.0.0.709'\n\njava {\n    toolchain {\n        languageVersion = JavaLanguageVersion.of(17)\n    }\n}\n\nconfigurations {\n    compileOnly {\n        extendsFrom annotationProcessor\n    }\n}\n\nrepositories {\n    mavenLocal()\n    mavenCentral()\n    maven {\n        url 'https://humana.jfrog.io/artifactory/eai-gradle-virtual'\n        credentials {\n            username System.getenv('ARTIFACTORY_USERNAME')\n            password System.getenv('ARTIFACTORY_PASSWORD')\n        }\n    }\n}\n\next {\n    set('springCloudVersion', \"2025.0.0\")\n    set('spring-framework.version', \"6.2.17\")\n}\n\n// Common exclusions for SonarQube and Jacoco\ndef coverageExclusions = [\n        \"**/com/humana/domain/cde/evaluation/App.java\",\n        \"**/com/humana/domain/cde/evaluation/config/**\",\n        \"**/com/humana/domain/cde/evaluation/contract/**\",\n        \"**/com/humana/domain/cde/evaluation/constants/**\",\n        \"**/com/humana/domain/cde/evaluation/dto/**\",\n        \"**/com/humana/domain/cde/evaluation/enums/**\",\n        \"**/com/humana/domain/cde/evaluation/entity/**\",\n        \"**/com/humana/domain/cde/evaluation/exceptions/**\",\n        \"**/com/humana/domain/cde/evaluation/repository/**\",\n        \"**/com/humana/domain/cde/evaluation/interfaces/**\",\n        \"**/com/humana/domain/cde/evaluation/model/**\",\n        \"**/com/humana/domain/cde/evaluation/util/**\"\n]\n\ndependencyManagement {\n    imports {\n        mavenBom \"org.springframework.cloud:spring-cloud-dependencies:${springCloudVersion}\"\n    }\n}\n\ndependencies {\n    // ---------------------------------------------------------\n    // Spring Boot & Framework\n    // ---------------------------------------------------------\n    implementation 'org.springframework.boot:spring-boot-starter-webflux'\n    implementation 'org.springframework.boot:spring-boot-starter-actuator'\n    implementation 'org.springframework.boot:spring-boot-starter-data-mongodb'\n    implementation 'org.springframework.boot:spring-boot-starter-validation'\n    implementation 'org.springframework.boot:spring-boot-starter-aop'\n    implementation 'org.springframework.data:spring-data-commons'\n    implementation 'org.springframework:spring-webflux:6.2.17'\n\n    // ---------------------------------------------------------\n    // Spring Cloud & Resilience\n    // ---------------------------------------------------------\n    implementation 'org.springframework.cloud:spring-cloud-starter-circuitbreaker-reactor-resilience4j'\n    implementation 'org.springframework.cloud:spring-cloud-contract-shade:4.3.1'\n\n    // ---------------------------------------------------------\n    // Kafka\n    // ---------------------------------------------------------\n    implementation('org.springframework.kafka:spring-kafka:3.3.5') {\n        exclude group: 'org.xerial.snappy', module: 'snappy-java'\n        exclude group: 'org.apache.kafka', module: 'kafka-clients'\n    }\n    implementation 'org.apache.kafka:kafka-clients:4.2.0'\n    implementation 'org.apache.avro:avro:1.12.0'\n\n    // ---------------------------------------------------------\n    // Reactor & Netty\n    // ---------------------------------------------------------\n    implementation 'io.projectreactor.netty:reactor-netty-core:1.2.8'\n    implementation 'io.projectreactor.netty:reactor-netty-http:1.2.8'\n\n    // ---------------------------------------------------------\n    // Observability\n    // ---------------------------------------------------------\n    implementation 'io.micrometer:micrometer-tracing-bridge-brave'\n    implementation 'net.logstash.logback:logstash-logback-encoder:8.0'\n\n    // ---------------------------------------------------------\n    // OpenAPI / Swagger\n    // ---------------------------------------------------------\n    implementation 'io.swagger.core.v3:swagger-annotations:2.2.26'\n    implementation 'org.webjars:webjars-locator-core:0.59'\n    implementation 'org.openapitools:jackson-databind-nullable:0.2.6'\n\n    // ---------------------------------------------------------\n    // Utilities (Lombok, Jackson, etc.)\n    // ---------------------------------------------------------\n    compileOnly 'org.projectlombok:lombok'\n    annotationProcessor 'org.projectlombok:lombok'\n    implementation 'jakarta.validation:jakarta.validation-api:3.1.1'\n    implementation 'com.google.code.findbugs:jsr305:3.0.2'\n    implementation 'com.auth0:java-jwt:4.4.0'\n\n    // Jackson\n    implementation 'com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:2.19.0'\n    implementation 'com.fasterxml.jackson.datatype:jackson-datatype-jsr310:2.19.0'\n\n    // ---------------------------------------------------------\n    // Vulnerability Fixes & Strict Versions\n    // ---------------------------------------------------------\n    implementation(group: 'org.yaml', name: 'snakeyaml') { version { strictly '2.4' } }\n    implementation(group: 'ch.qos.logback', name: 'logback-classic') { version { strictly '1.5.25' } } // fix of CVE-2026-1225 and CVE-2025-11226.\n    implementation(group: 'ch.qos.logback', name: 'logback-core') { version { strictly '1.5.25' } }    // fix of CVE-2026-1225 and CVE-2025-11226.\n\n    // Jackson Strict\n    implementation(group: 'com.fasterxml.jackson.core', name: 'jackson-databind') { version { strictly '2.19.4' } }\n    implementation(group: 'com.fasterxml.jackson.core', name: 'jackson-annotations') { version { strictly '2.19.4' } }\n    implementation(group: 'com.fasterxml.jackson.core', name: 'jackson-core') { version { strictly '2.21.2' } }\n\n    // Other Strict\n    implementation(group: 'com.jayway.jsonpath', name: 'json-path') { version { strictly '2.9.0' } }\n    implementation(group: 'org.bouncycastle', name: 'bcprov-jdk18on') { version { strictly '1.84' } }\n    implementation(group: 'com.google.protobuf', name: 'protobuf-java') { version { strictly \"[4.30.1]\" } }\n    implementation(group: 'com.launchdarkly', name: 'launchdarkly-java-server-sdk') { version { strictly '7.5.0' } }\n    implementation(group: 'org.apache.cxf', name: 'cxf-rt-transports-http') { version { strictly '4.1.3' } } //fix of CVE-2025-48913\n    implementation(group: 'org.apache.commons', name: 'commons-lang3') { version { strictly '3.18.0' } }\n    implementation(group: 'com.github.jknack', name: 'handlebars') { version { strictly \"[4.4.0]\" } }\n\n    // ---------------------------------------------------------\n    // Testing\n    // ---------------------------------------------------------\n    testImplementation 'org.springframework.boot:spring-boot-starter-test'\n    testImplementation 'org.junit.jupiter:junit-jupiter-params'\n    testImplementation 'io.projectreactor:reactor-test'\n    testImplementation 'org.springframework.cloud:spring-cloud-starter-contract-stub-runner:4.3.1'\n    testImplementation('com.google.guava:guava') { version { strictly '33.4.8-jre' } }\n    testImplementation('org.codehaus.plexus:plexus-utils') { version { strictly '3.4.1' } }\n}\n\nsonarqube {\n    properties {\n        property \"sonar.projectKey\", \"IntegratedHealth.ConsentAndPreferences.IntegratedHealth.ConsentAndPreferences.cw-cp-mgmt-evaluation-workflow\"\n        property \"sonar.host.url\", \"http://analysis-devops.humana.com\"\n        property \"sonar.login\", System.getenv(\"SONARQUBE_TOKEN\")\n        property \"sonar.java.binaries\", \"${layout.buildDirectory.get()}/classes/java/main\"\n        property \"sonar.junit.reportsPath\", \"${layout.buildDirectory.get()}/test-results/test/\"\n        property \"sonar.jacoco.reportPaths\", \"${layout.buildDirectory.get()}/reports/jacoco/test/jacocoTestReport.xml\"\n        property 'sonar.coverage.exclusions', coverageExclusions.join(\",\")\n        property \"sonar.coverage.exclusions\",\n                \"**/com/humana/domain/cde/evaluation/App.java,\" +\n                        \"**/com/humana/domain/cde/evaluation/client/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/config/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/constants/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/contract/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/dto/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/enums/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/entity/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/exceptions/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/repository/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/interfaces/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/model/**,\" +\n                        \"**/com/humana/domain/cde/evaluation/util/**\"\n        property \"sonar.exclusions\",\n                \"**/com/humana/domain/cde/evaluation/contract/**\"\n    }\n}\n\ntasks.sonarqube.dependsOn = []\n\ntest {\n    useJUnitPlatform()\n\n    jvmArgs += [\n            \"--add-opens\", \"java.base/java.lang=ALL-UNNAMED\",\n            \"--add-opens\", \"java.base/java.lang.reflect=ALL-UNNAMED\",\n            \"--add-opens\", \"java.base/java.util=ALL-UNNAMED\"\n    ]\n\n    jacocoTestReport {\n        reports {\n            xml.required.set(true)\n            html.required.set(true)\n            xml.destination file(\"${layout.buildDirectory.get()}/reports/jacoco/test/jacocoTestReport.xml\")\n            html.destination file(\"${layout.buildDirectory.get()}/jacocoReport\")\n        }\n        finalizedBy jacocoTestCoverageVerification\n        afterEvaluate {\n            classDirectories.setFrom(files(classDirectories.files.collect {\n                fileTree(dir: it, exclude: coverageExclusions)\n            }))\n        }\n    }\n    finalizedBy jacocoTestReport\n}\n\ntasks.register('cwih-cp-mgmt-evaluation-workflow') {\n    doLast {\n        println 'Running cwih-cp-mgmt-evaluation-workflow task'\n    }\n}\n\n//tasks.register('generateAvroEvent') {\n//    doLast {\n//        def pathJar = \"${projectDir}/src/main/libs/avro-tools-1.12.0.jar\"\n//        def pathInput = \"${projectDir}/src/main/resources/avro/cde_udap_outbound.avsc\"\n//        def pathOutput = \"${projectDir}/src/main/java\"\n//        exec {\n//            commandLine 'java', '-jar', pathJar, 'compile', 'schema', pathInput, pathOutput\n//        }\n//\n//        println(\"executed\")\n//    }\n//}\n//tasks.named(\"build\") {\n//    finalizedBy(\"generateAvroEvent\")\n//}",
